# Copy to .env.local and fill in. EXPO_PUBLIC_* vars are inlined into the app at
# build time — only ever put PUBLIC-safe values here (the Supabase anon key is
# safe; the service_role key is NOT and must never appear in this app).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Public Mapbox token (pk.…) for rendering the day-plan map.
EXPO_PUBLIC_MAPBOX_TOKEN=pk.YOUR-PUBLIC-TOKEN

# SECRET Mapbox token (sk.…, DOWNLOADS:READ) — build time only, read by
# app.config.js to download the native SDK. Never shipped in the bundle.
MAPBOX_DOWNLOAD_TOKEN=sk.YOUR-DOWNLOADS-TOKEN

# Google Maps/Places keys are used server-side (Edge Functions), NOT here.
